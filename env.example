# Copy to .env and fill local values. Do not commit .env.
#
# 팝빌 API는 계정 로그인 비밀번호가 아니라 LinkID/SecretKey와 회원 아이디를 사용합니다.
# 운영 전환 PDF 기준: POPBILL_IS_TEST=false
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
POPBILL_CORP_NUM=5038181331
POPBILL_USER_ID=hostingglobal
POPBILL_IS_TEST=false
POPBILL_IP_RESTRICT=true
POPBILL_USE_STATIC_IP=false
POPBILL_USE_LOCAL_TIME=true
POPBILL_USE_GA_IP=false

POPBILL_FAX_APPROVAL_URL=http://127.0.0.1:5510
POPBILL_FAX_APPROVAL_TIMEOUT_SEC=600
POPBILL_FAX_SIREN_STATUS_URL=
POPBILL_FAX_SIREN_WAIT_SEC=12
